---
import type { CollectionEntry } from 'astro:content';
import { type Lang, t } from '../i18n';
import SearchBox from './SearchBox.astro';

interface Props {
  lang: Lang;
  worlds: CollectionEntry<'worlds'>[];
}

const { lang, worlds } = Astro.props;
---

<nav id="world-sidebar" class="sidebar" data-sidebar aria-label={t('sidebar.label', lang)}>
  <SearchBox lang={lang} />
  <ul>
    {
      worlds.map(({ data }) => (
        <li>
          <a href={`?world=${data.slug}`} data-world-link={data.slug} data-world-name={data.name}>
            <span class="name">{data.name}</span>
            <span class="kind">{t(`classification.${data.classification}`, lang)}</span>
          </a>
        </li>
      ))
    }
  </ul>
  <p data-search-empty class="empty" hidden>{t('search.no-results', lang)}</p>
</nav>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    min-height: 0;
    padding: var(--space-m);
    border-right: 1px solid var(--color-border);
    background: var(--color-panel);
    overflow-y: auto;
  }

  ul {
    display: grid;
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li[hidden] {
    display: none;
  }

  a {
    display: grid;
    padding: var(--space-s);
    border-left: 3px solid transparent;
    border-radius: 4px;
    color: var(--color-text);
    text-decoration: none;
  }

  a:hover {
    background: var(--color-border);
  }

  a[aria-current='true'] {
    border-left-color: var(--color-accent);
    background: var(--color-border);
    font-weight: 600;
  }

  .kind {
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    font-weight: 400;
  }

  .empty {
    margin: 0;
    color: var(--color-text-muted);
  }

  @media (max-width: 767px) {
    .sidebar {
      position: absolute;
      inset: 0;
      z-index: 2;
      display: none;
      border-right: 0;
    }

    .sidebar[data-open] {
      display: flex;
    }
  }
</style>
